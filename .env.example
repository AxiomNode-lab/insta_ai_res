# App
PROJECT_NAME="Instagram Auto Reply System"
API_V1_STR="/api/v1"
SECRET_KEY="replace-with-32-plus-random-characters"
SECRET_KEY_PREVIOUS=""
ENV="development" # production, development, test
OPS_API_TOKEN="replace-with-32-plus-random-characters"
OPS_API_TOKEN_PREVIOUS=""

# Postgres
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-random-database-password
POSTGRES_DB=insta_bot_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:replace-with-random-database-password@localhost:5432/insta_bot_db

# Redis
REDIS_PASSWORD=replace-with-random-redis-password
REDIS_MAXMEMORY=384mb
REDIS_URL=redis://:replace-with-random-redis-password@localhost:6379/0
REDIS_SOCKET_TIMEOUT_SECONDS=2

# Instagram / Meta
META_APP_SECRET="your_app_secret"
META_APP_SECRET_PREVIOUS=""
META_VERIFY_TOKEN="your_verify_token"
META_GRAPH_API_VERSION="v26.0"
INSTAGRAM_ACCESS_TOKEN="your_access_token" # Initial token, system should handle refresh
INSTAGRAM_PAGE_ID="your_page_id"

# Telegram
TELEGRAM_BOT_TOKEN="your_bot_token"
ADMIN_IDS=[123456789]

# Ingress and queue policy
MAX_WEBHOOK_BODY_BYTES=1048576
WEBHOOK_INGRESS_RATE_LIMIT_PER_MINUTE=300
WEBHOOK_RATE_LIMIT_PER_MINUTE=120
PUBLIC_RATE_LIMIT_PER_MINUTE=60
WEBHOOK_DEDUP_TTL_SECONDS=604800
WEBHOOK_PROCESSING_LEASE_SECONDS=300
WEBHOOK_MAX_ATTEMPTS=6
WEBHOOK_RETRY_BASE_SECONDS=5
WEBHOOK_QUEUE_MAX_DEPTH=250
OUTBOUND_QUEUE_MAX_DEPTH=1000
WORKER_POOL_SIZE=4
DB_AUTO_CREATE_SCHEMA=false
